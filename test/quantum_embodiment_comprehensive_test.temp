import 'package:flutter/material.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:sqflite_common_ffi/sqflite_ffi.dart';
import 'package:path_provider_platform_interface/path_provider_platform_interface.dart';
import 'package:path_provider_windows/path_provider_windows.dart';
import 'package:quantum_layout/quantum.dart';
import 'package:quantum_layout/quantum_embodiment_engine.dart';

void main() {
  setUpAll(() async {
    // Initialize FFI for SQLite in desktop tests
    sqfliteFfiInit();
    databaseFactory = databaseFactoryFfi;
    PathProviderPlatform.instance = PathProviderWindows();

    TestWidgetsFlutterBinding.ensureInitialized();
    QuantumVM.instance.initialize();
    
    // Configure QEE with an in-memory SQLite DB for testing
    await QEmbodiment.configure(const QEEConfig(
      dbPath: inMemoryDatabasePath,
      captureTelemetry: true,
      captureMemory: true,
      verboseLog: false,
    ));
    
    // Register basic schemas required for testing
    QLSchemaRegistry.instance.register(QLSchemaBlueprint(
      name: 'qee.User',
      type: 'object',
      properties: {
        'id': QLSchemaBlueprint(name: 'id', type: 'string'),
        'name': QLSchemaBlueprint(name: 'name', type: 'string'),
        'age': QLSchemaBlueprint(name: 'age', type: 'int'),
      },
      required: ['id', 'name'],
    ));
  });

  tearDownAll(() async {
    // Clean up
    await QEmbodiment.store.deleteWhere(tags: null); // Clear all
  });

  group('§1. Probe Layer Verification', () {
    testWidgets('UIProbe & LayoutProbe capture full component tree', (tester) async {
      final trace = await QEmbodiment.run(
        name: 'probe: ui and layout',
        tags: ['probe', 'ui'],
        kind: QEEKind.widget,
        tester: tester,
        probes: {QEEProbeKind.ui, QEEProbeKind.layout},
        exec: (e) => e.widget.mount({
          'type': 'box:col',
          'props': {
            'width': 200.0,
            'height': 300.0,
          },
          'children': [
            {'type': 'text', 'props': {'text': 'Hello UI Probe'}},
            {'type': 'box:row', 'children': [
               {'type': 'text', 'props': {'text': 'Nested Node'}}
            ]}
          ]
        }),
        assert_: (a, p) {
          a.noErrors(p);
          a.custom('UI tree is captured', () {
            final ui = p.ui;
            if (ui == null) return false;
            // The root node should be our box:col
            return ui.type == 'box:col' && ui.children.length == 2;
          });
          a.custom('Nested children are captured', () {
             final row = p.ui!.children[1];
             return row.type == 'box:row' && row.children[0].type == 'text';
          });
          a.custom('Layout sizes are captured', () {
             final layout = p.layout;
             return layout != null && layout.nodes.isNotEmpty;
          });
        }
      );
      expect(trace.summary?.allPassed, isTrue);
    });

    testWidgets('DataProbe captures deep reactive state', (tester) async {
      final trace = await QEmbodiment.run(
        name: 'probe: data deep state',
        tags: ['probe', 'data'],
        kind: QEEKind.data,
        exec: (e) async {
          e.data.merge({
            'deep': {
               'nested': {
                  'value': 42,
                  'list': [1, 2, 3]
               }
            }
          });
          return QEEExecResult.ok(null, 0);
        },
        assert_: (a, p) {
           a.dataPath('deep.nested.value', 42)
            .dataPath('deep.nested.list[1]', 2);
           
           a.custom('Data snapshot matches full store map', () {
              final map = p.data.store;
              return map['deep'] != null && (map['deep'] as Map)['nested']['value'] == 42;
           });
        }
      );
      expect(trace.summary?.allPassed, isTrue);
    });

    testWidgets('MemoryProbe captures memory footprint', (tester) async {
      final trace = await QEmbodiment.run(
        name: 'probe: memory capture',
        kind: QEEKind.vm,
        probes: {QEEProbeKind.memory},
        exec: (e) async {
           // Allocate some memory
           List<int> dummy = List.generate(100000, (i) => i);
           return QEEExecResult.ok(dummy.length, 0);
        },
        assert_: (a, p) {
           a.custom('Memory delta is positive', () {
              return p.memory != null && p.memory!.deltaRss >= 0;
           });
        }
      );
      expect(trace.summary?.allPassed, isTrue);
    });
  });

  group('§2. Executor Layer Combinations', () {
    testWidgets('JsonExecutor compiles complex schemas and renders', (tester) async {
      final trace = await QEmbodiment.run(
        name: 'executor: json injection',
        tester: tester,
        exec: (e) => e.json.inject({
          'type': 'box:stack',
          'children': [
             {'type': 'text', 'props': {'text': 'Base'}},
             {'type': 'text', 'props': {'text': 'Overlay'}}
          ]
        }),
        assert_: (a, p) {
           a.noErrors(p);
           a.custom('Stack has 2 children', () {
             return p.ui?.type == 'box:stack' && p.ui?.children.length == 2;
           });
        }
      );
      expect(trace.summary?.allPassed, isTrue);
    });

    testWidgets('SchemaExecutor correctly validates invalid and valid payloads', (tester) async {
      final trace = await QEmbodiment.run(
        name: 'executor: schema validation',
        kind: QEEKind.vm,
        exec: (e) async {
           final valid = e.schema.validate('qee.User', {'id': '1', 'name': 'John'});
           final invalid = e.schema.validate('qee.User', {'name': 'Missing ID'});
           return QEEExecResult.ok({
             'valid': valid.success,
             'invalid': invalid.success,
             'invalid_errors': invalid.errors,
           }, 0);
        },
        assert_: (a, p) {
           a.dataPath('valid', true)
            .dataPath('invalid', false);
        }
      );
      expect(trace.summary?.allPassed, isTrue);
    });
    
    testWidgets('ScriptExecutor runs Dart lambdas safely', (tester) async {
       final trace = await QEmbodiment.run(
         name: 'executor: script execution',
         kind: QEEKind.script,
         exec: (e) => e.script.run((vm, ds, t) async {
            ds.set('script.injected', true);
            return QEEExecResult.ok('success', 0);
         }),
         assert_: (a, p) {
            a.dataPath('script.injected', true);
         }
       );
       expect(trace.summary?.allPassed, isTrue);
    });
  });

  group('§3. Policy Engine', () {
    testWidgets('OnDataChange triggers Policy Evaluation', (tester) async {
       QEmbodiment.policy(
         id: 'policy.no.negative.stock',
         name: 'Stock cannot be negative',
         trigger: PolicyTriggerEvent.onStepEnd, // End of execution
         targetPattern: 'inventory',
         severity: PolicySeverity.error,
         evaluate: (probe, step) {
            final val = probe.data.read('inventory.stock');
            if (val is num && val < 0) return 'Negative stock: \$val';
            return null;
         }
       );

       final trace = await QEmbodiment.run(
         name: 'policy: inventory test',
         exec: (e) async {
            e.data.set('inventory.stock', -5);
            return QEEExecResult.ok(null, 0);
         }
       );

       final hasViolation = trace.violations.any((v) => v.policyId == 'policy.no.negative.stock');
       expect(hasViolation, isTrue);
       expect(trace.summary?.allPassed, isFalse); // Because policy failed
       
       QEEPolicyEngine.instance.unregister('policy.no.negative.stock');
    });
  });

  group('§4. Scenario Workflows', () {
    testWidgets('Multi-step with rollback works on failure', (tester) async {
      QuantumVM.instance.store.set('workflow.val', 'original');
      
      final trace = await QEmbodiment.scenario(
        name: 'scenario: branching and rollback',
      )
      .step('set modified', (e) async {
         e.data.set('workflow.val', 'modified');
         return QEEExecResult.ok(null, 0);
      })
      .step('intentional failure', (e) async {
         return QEEExecResult.fail('Simulated failure', 0);
      })
      .run();

      expect(trace.summary?.allPassed, isFalse); // The trace should fail
      // Rollback should have occurred
      expect(QuantumVM.instance.store.get('workflow.val'), 'original');
    });
  });
  
  group('§5. Storage & Persistence', () {
    testWidgets('Trace can be saved, queried, and deleted from SQLite', (tester) async {
       final trace = await QEmbodiment.run(
         name: 'storage: db query test',
         tags: ['storage', 'db'],
         exec: (e) async => QEEExecResult.ok('done', 0)
       );
       
       // Because it automatically saves at end of trace execution
       final results = await QEmbodiment.store.query(tags: ['db']);
       expect(results.length, greaterThanOrEqualTo(1));
       
       final storedTrace = results.firstWhere((t) => t.id == trace.id);
       expect(storedTrace.name, 'storage: db query test');
       
       await QEmbodiment.store.delete(trace.id);
       
       final resultsAfter = await QEmbodiment.store.query(tags: ['db']);
       expect(resultsAfter.any((t) => t.id == trace.id), isFalse);
    });
  });
}
