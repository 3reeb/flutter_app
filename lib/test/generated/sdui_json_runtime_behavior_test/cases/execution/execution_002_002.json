{
  "__meta": {
    "id": "execution-002-button-state-set",
    "title": "Button tap mutates live store state",
    "description": "Tap a real button that dispatches a state.set action and verify the store changes after the event chain resolves.",
    "tags": [
      "execution",
      "action",
      "state",
      "tap"
    ],
    "allowBlank": false,
    "priority": "critical"
  },
  "input": {
    "state": {
      "count": 0
    },
    "type": "action:button",
    "props": {
      "text": "Increment",
      "onTap": [
        {
          "action": "state.set",
          "key": "count",
          "value": 1
        }
      ]
    }
  },
  "expected": {
    "type": "system",
    "props": {
      "__subType": "store_provider",
      "initialState": {
        "count": 0
      }
    },
    "debugPath": "root.store_provider",
    "children": [
      {
        "type": "action",
        "props": {
          "__subType": "button",
          "text": "Increment",
          "onTap": [
            {
              "action": "state.set",
              "key": "count",
              "value": 1
            }
          ]
        },
        "debugPath": "root"
      }
    ]
  },
  "runtimeAssertions": [
    {
      "path": "type",
      "equals": "system"
    },
    {
      "path": "props.__subType",
      "equals": "store_provider"
    },
    {
      "path": "children.length",
      "equals": 1
    }
  ],
  "runtimeBehavior": {
    "gesture": "tap",
    "description": "A button click triggers a single state.set action against the live store."
  },
  "executionSteps": [
    {
      "action": "pumpAndSettle"
    },
    {
      "action": "tap",
      "finder": {
        "type": "text",
        "match": "Increment"
      }
    },
    {
      "action": "pumpAndSettle"
    },
    {
      "action": "expectState",
      "path": "count",
      "equals": 1
    }
  ]
}
