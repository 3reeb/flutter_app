{
  "__meta": {
    "id": "execution-091-repeat-flow",
    "title": "Repeat execution replays the same tap twice #091",
    "description": "Use a repeat block to execute the same widget interaction twice and verify the live store reaches the expected value.",
    "tags": [
      "execution",
      "repeat",
      "group",
      "button"
    ],
    "allowBlank": false,
    "priority": "high"
  },
  "input": {
    "state": {
      "repeat.count.91": 0
    },
    "type": "action:button",
    "props": {
      "text": "Replay 091",
      "onTap": [
        {
          "action": "increment",
          "path": "repeat.count.91",
          "amount": 1
        }
      ]
    }
  },
  "expected": {
    "type": "system",
    "props": {
      "__subType": "store_provider",
      "initialState": {
        "repeat.count.91": 0
      }
    },
    "debugPath": "root.store_provider",
    "children": [
      {
        "type": "action",
        "props": {
          "__subType": "button",
          "text": "Replay 091",
          "onTap": [
            {
              "action": "increment",
              "path": "repeat.count.91",
              "amount": 1
            }
          ]
        },
        "debugPath": "root"
      }
    ]
  },
  "runtimeAssertions": [
    {
      "path": "children.length",
      "equals": 1
    }
  ],
  "runtimeBehavior": {
    "gesture": "repeat tap",
    "description": "A repeat execution block replays the same tap twice."
  },
  "executionSteps": [
    {
      "action": "pumpAndSettle"
    },
    {
      "action": "group",
      "steps": [
        {
          "action": "repeat",
          "times": 2,
          "steps": [
            {
              "action": "tap",
              "finder": {
                "type": "text",
                "match": "Replay 091"
              }
            },
            {
              "action": "pumpAndSettle"
            }
          ]
        }
      ]
    },
    {
      "action": "expectState",
      "path": "repeat.count.91",
      "equals": 2
    }
  ]
}
