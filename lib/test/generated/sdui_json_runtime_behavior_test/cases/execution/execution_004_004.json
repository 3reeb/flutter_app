{
  "__meta": {
    "id": "execution-004-repeat-tap-increment",
    "title": "Repeat steps can drive the same tap twice",
    "description": "Use nested repeat execution steps to fire the same button tap twice and verify the store increments twice.",
    "tags": [
      "execution",
      "repeat",
      "group",
      "increment"
    ],
    "allowBlank": false,
    "priority": "high"
  },
  "input": {
    "state": {
      "count": 0
    },
    "type": "action:button",
    "props": {
      "text": "Toggle Armed",
      "onTap": [
        {
          "action": "increment",
          "path": "count",
          "amount": 1
        }
      ]
    }
  },
  "expected": {
    "type": "system",
    "props": {
      "__subType": "store_provider",
      "initialState": {
        "count": 0
      }
    },
    "debugPath": "root.store_provider",
    "children": [
      {
        "type": "action",
        "props": {
          "__subType": "button",
          "text": "Toggle Armed",
          "onTap": [
            {
              "action": "increment",
              "path": "count",
              "amount": 1
            }
          ]
        },
        "debugPath": "root"
      }
    ]
  },
  "runtimeAssertions": [
    {
      "path": "children.length",
      "equals": 1
    }
  ],
  "runtimeBehavior": {
    "gesture": "repeat tap",
    "description": "The same tap is replayed twice through a repeat block."
  },
  "executionSteps": [
    {
      "action": "pumpAndSettle"
    },
    {
      "action": "repeat",
      "times": 2,
      "steps": [
        {
          "action": "tap",
          "finder": {
            "type": "text",
            "match": "Toggle Armed"
          }
        },
        {
          "action": "pumpAndSettle"
        }
      ]
    },
    {
      "action": "expectState",
      "path": "count",
      "equals": 2
    }
  ]
}
