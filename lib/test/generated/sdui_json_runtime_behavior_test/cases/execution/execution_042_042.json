{
  "__meta": {
    "id": "execution-042-button-set",
    "title": "Button set action updates scoped store #042",
    "description": "Tap a real button and verify a state.set action mutates the live scoped store.",
    "tags": [
      "execution",
      "button",
      "state",
      "tap"
    ],
    "allowBlank": false,
    "priority": "high"
  },
  "input": {
    "state": {
      "counter.42": 0
    },
    "type": "action:button",
    "props": {
      "text": "Apply 042",
      "onTap": {
        "action": "state.set",
        "key": "counter.42",
        "value": 1
      }
    }
  },
  "expected": {
    "type": "system",
    "props": {
      "__subType": "store_provider",
      "initialState": {
        "counter.42": 0
      }
    },
    "debugPath": "root.store_provider",
    "children": [
      {
        "type": "action",
        "props": {
          "__subType": "button",
          "text": "Apply 042",
          "onTap": {
            "action": "state.set",
            "key": "counter.42",
            "value": 1
          }
        },
        "debugPath": "root"
      }
    ]
  },
  "runtimeAssertions": [
    {
      "path": "type",
      "equals": "system"
    },
    {
      "path": "props.__subType",
      "equals": "store_provider"
    },
    {
      "path": "children.length",
      "equals": 1
    }
  ],
  "runtimeBehavior": {
    "gesture": "tap",
    "description": "Pressing Apply 042 updates the live scoped store."
  },
  "executionSteps": [
    {
      "action": "pumpAndSettle"
    },
    {
      "action": "tap",
      "finder": {
        "type": "text",
        "match": "Apply 042"
      }
    },
    {
      "action": "pumpAndSettle"
    },
    {
      "action": "expectState",
      "path": "counter.42",
      "equals": 1
    }
  ]
}
