{
  "__meta": {
    "id": "execution-050-button-toggle",
    "title": "Button toggle action flips a boolean store flag #050",
    "description": "Tap a real button and verify a toggle action mutates the live scoped store.",
    "tags": [
      "execution",
      "button",
      "toggle",
      "state"
    ],
    "allowBlank": false,
    "priority": "high"
  },
  "input": {
    "state": {
      "counter.50": false
    },
    "type": "action:button",
    "props": {
      "text": "Apply 050",
      "onTap": {
        "action": "toggle",
        "path": "counter.50"
      }
    }
  },
  "expected": {
    "type": "system",
    "props": {
      "__subType": "store_provider",
      "initialState": {
        "counter.50": false
      }
    },
    "debugPath": "root.store_provider",
    "children": [
      {
        "type": "action",
        "props": {
          "__subType": "button",
          "text": "Apply 050",
          "onTap": {
            "action": "toggle",
            "path": "counter.50"
          }
        },
        "debugPath": "root"
      }
    ]
  },
  "runtimeAssertions": [
    {
      "path": "type",
      "equals": "system"
    },
    {
      "path": "props.__subType",
      "equals": "store_provider"
    },
    {
      "path": "children.length",
      "equals": 1
    }
  ],
  "runtimeBehavior": {
    "gesture": "tap",
    "description": "Pressing Apply 050 updates the live scoped store."
  },
  "executionSteps": [
    {
      "action": "pumpAndSettle"
    },
    {
      "action": "tap",
      "finder": {
        "type": "text",
        "match": "Apply 050"
      }
    },
    {
      "action": "pumpAndSettle"
    },
    {
      "action": "expectState",
      "path": "counter.50",
      "equals": true
    }
  ]
}
