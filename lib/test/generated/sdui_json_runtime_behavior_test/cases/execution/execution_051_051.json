    "children": [
      {
        "type": "action",
        "props": {
          "__subType": "button",
          "text": "Apply 051",
          "onTap": [
            {
              "action": "state.set",
              "key": "counter.51",
              "value": 3
            }
          ]
        },
        "debugPath": "root"
      }
    ]
  },
  "runtimeAssertions": [
    {
      "path": "type",
      "equals": "system"
    },
    {
      "path": "props.__subType",
      "equals": "store_provider"
    },
    {
      "path": "children.length",
      "equals": 1
    }
  ],
  "runtimeBehavior": {
    "gesture": "tap",
    "description": "Pressing Apply 051 updates the live scoped store."
