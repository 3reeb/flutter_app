{
  "__meta": {
    "id": "compile_time-085-let-085",
    "title": "Let bindings interpolate children #085",
    "description": "The $let operator should resolve compile-time placeholders in descendants.",
    "tags": [
      "compile-time",
      "let",
      "interpolation"
    ],
    "allowBlank": false
  },
  "input": {
    "type": "box:col",
    "$let": {
      "title": "Dashboard 085",
      "subtitle": "Quarter 15"
    },
    "children": [
      {
        "type": "text",
        "props": {
          "text": "{{title}}"
        }
      },
      {
        "type": "text",
        "props": {
          "text": "{{subtitle}}"
        }
      }
    ]
  },
  "expected": {
    "type": "box:col",
    "props": {},
    "debugPath": "root",
    "children": [
      {
        "type": "text",
        "props": {
          "text": "Dashboard 085"
        },
        "debugPath": "root[0]"
      },
      {
        "type": "text",
        "props": {
          "text": "Quarter 15"
        },
        "debugPath": "root[1]"
      }
    ]
  }
}
