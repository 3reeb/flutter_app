{
  "__meta": {
    "id": "compile_time-050-scope-050",
    "title": "Scope prefixes descendant bindings #050",
    "description": "The $scope operator should prefix descendant bindings with the active scope.",
    "tags": [
      "compile-time",
      "scope",
      "binding"
    ],
    "allowBlank": false
  },
  "input": {
    "type": "box:col",
    "$scope": "user",
    "children": [
      {
        "type": "data",
        "props": {
          "bind": "profile.1",
          "mode": "read"
        }
      }
    ]
  },
  "expected": {
    "type": "box:col",
    "props": {},
    "debugPath": "root",
    "children": [
      {
        "type": "data",
        "props": {
          "bind": "user.profile.1",
          "mode": "read"
        },
        "debugPath": "root[0]"
      }
    ]
  }
}
