{
  "__meta": {
    "id": "basic-009-metadata-009",
    "title": "Name and slot metadata survive compilation #009",
    "description": "Top-level name and slot values should be copied into props, and nested slots must keep their own slot metadata.",
    "tags": [
      "basic",
      "metadata",
      "slots"
    ],
    "allowBlank": false
  },
  "input": {
    "type": "text",
    "name": "headline_009",
    "slot": "hero",
    "props": {
      "text": "Title 009"
    },
    "slots": {
      "badge": {
        "type": "text",
        "slot": "badge",
        "props": {
          "text": "New 009"
        }
      }
    }
  },
  "expected": {
    "type": "text",
    "props": {
      "text": "Title 009",
      "name": "headline_009",
      "slot": "hero"
    },
    "debugPath": "headline_009",
    "slots": {
      "badge": {
        "type": "text",
        "props": {
          "text": "New 009",
          "slot": "badge"
        },
        "debugPath": "headline_009.slots[badge]"
      }
    }
  }
}