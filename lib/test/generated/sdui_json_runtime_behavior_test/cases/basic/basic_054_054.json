{
  "__meta": {
    "id": "basic-054-metadata-054",
    "title": "Name and slot metadata survive compilation #054",
    "description": "Top-level name and slot values should be copied into props, and nested slots must keep their own slot metadata.",
    "tags": [
      "basic",
      "metadata",
      "slots"
    ],
    "allowBlank": false
  },
  "input": {
    "type": "text",
    "name": "headline_054",
    "slot": "hero",
    "props": {
      "text": "Title 054"
    },
    "slots": {
      "badge": {
        "type": "text",
        "slot": "badge",
        "props": {
          "text": "New 054"
        }
      }
    }
  },
  "expected": {
    "type": "text",
    "props": {
      "text": "Title 054",
      "name": "headline_054",
      "slot": "hero"
    },
    "debugPath": "headline_054",
    "slots": {
      "badge": {
        "type": "text",
        "props": {
          "text": "New 054",
          "slot": "badge"
        },
        "debugPath": "headline_054.slots[badge]"
      }
    }
  }
}