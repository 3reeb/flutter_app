            "debugPath": "root[0][1]",
            "children": [
              {
                "type": "text",
                "props": {
                  "text": "Grid B 055"
                },
                "debugPath": "root[0][1][0]"
              }
            ]
          }
        ]
      },
      {
        "type": "system",
        "props": {
          "__subType": "repeater",
