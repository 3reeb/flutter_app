            "type": "text",
            "props": {
              "text": "Grid A 055"
            }
          },
          "b": {
            "type": "text",
            "props": {
              "text": "Grid B 055"
            }
          }
        }
      },
      {
        "$repeat": "items.batch_1",
        "type": "text",
        "props": {
          "text": "Repeat 055"
        }
      }
    ]
  },
  "expected": {
    "type": "box:col",
    "props": {},
