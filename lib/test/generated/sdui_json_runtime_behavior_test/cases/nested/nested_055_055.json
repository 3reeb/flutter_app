            "children": [
              {
                "type": "text",
                "props": {
                  "text": "Grid A 055"
                },
                "debugPath": "root[0][0][0]"
              }
            ]
          },
          {
            "type": "box:grid_item",
            "props": {
              "rowStart": 2,
