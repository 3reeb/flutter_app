        "type": "text",
        "props": {
          "text": "Top 100"
        }
      },
      {
        "type": "box:row",
        "style": "gap-3",
        "children": [
          {
            "type": "text",
            "props": {
              "text": "L"
            }
          },
          {
            "type": "text",
            "props": {
              "text": "R"
            }
          }
        ]
      },
      {
        "$parallel": [
          {
            "type": "text",
            "props": {
              "text": "P1 100"
            }
          },
          {
            "type": "text",
            "props": {
              "text": "P2 100"
            }
          }
        ]
      }
    ]
  },
  "expected": {
