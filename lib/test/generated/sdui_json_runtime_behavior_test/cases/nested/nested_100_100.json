            "debugPath": "root[1][0]"
          },
          {
            "type": "text",
            "props": {
              "text": "R"
            },
            "debugPath": "root[1][1]"
          }
        ]
      },
      {
        "type": "box:col",
        "props": {},
        "debugPath": "root[2]",
        "children": [
          {
            "type": "text",
            "props": {
              "text": "P1 100"
            },
            "debugPath": "root[2][0]"
          },
          {
            "type": "text",
            "props": {
              "text": "P2 100"
            },
            "debugPath": "root[2][1]"
          }
        ]
      }
    ]
