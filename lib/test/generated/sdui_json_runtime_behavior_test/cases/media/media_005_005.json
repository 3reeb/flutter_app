{
  "__meta": {
    "id": "media-005-webrtc",
    "title": "media webrtc node preserves room and fit settings",
    "description": "The live video node must preserve its roomId and fit mode so the runtime can attach the correct WebRTC surface.",
    "tags": [
      "media",
      "webrtc",
      "video",
      "props"
    ],
    "allowBlank": false,
    "priority": "normal"
  },
  "input": {
    "type": "media",
    "props": {
      "__subType": "webrtc",
      "roomId": "room-alpha",
      "fit": "contain"
    }
  },
  "expected": {
    "type": "media",
    "props": {
      "__subType": "webrtc",
      "roomId": "room-alpha",
      "fit": "contain"
    },
    "debugPath": "root"
  },
  "runtimeAssertions": [
    {
      "path": "props.__subType",
      "equals": "webrtc"
    },
    {
      "path": "props.roomId",
      "equals": "room-alpha"
    },
    {
      "path": "props.fit",
      "equals": "contain"
    }
  ]
}