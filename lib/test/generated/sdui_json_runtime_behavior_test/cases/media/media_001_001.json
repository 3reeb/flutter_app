{
  "__meta": {
    "id": "media-001-video-surface",
    "title": "media video surface preserves transport props",
    "description": "A media node with __subType video must preserve URLs, subtitles, autoplay, and fit-related props.",
    "tags": [
      "media",
      "video",
      "surface",
      "props"
    ],
    "allowBlank": false,
    "priority": "high"
  },
  "input": {
    "type": "media",
    "props": {
      "__subType": "video",
      "src": "https://cdn.example.com/intro.mp4",
      "audioUrl": "https://cdn.example.com/intro.m4a",
      "poster": "https://cdn.example.com/poster.jpg",
      "subtitleUrl": "https://cdn.example.com/subtitles.srt",
      "subtitleOffsetMs": 250,
      "fit": "contain",
      "autoPlay": false,
      "loop": false
    }
  },
  "expected": {
    "type": "media",
    "props": {
      "__subType": "video",
      "src": "https://cdn.example.com/intro.mp4",
      "audioUrl": "https://cdn.example.com/intro.m4a",
      "poster": "https://cdn.example.com/poster.jpg",
      "subtitleUrl": "https://cdn.example.com/subtitles.srt",
      "subtitleOffsetMs": 250,
      "fit": "contain",
      "autoPlay": false,
      "loop": false
    },
    "debugPath": "root"
  },
  "runtimeAssertions": [
    {
      "path": "type",
      "equals": "media"
    },
    {
      "path": "props.__subType",
      "equals": "video"
    },
    {
      "path": "props.src",
      "equals": "https://cdn.example.com/intro.mp4"
    },
    {
      "path": "props.audioUrl",
      "equals": "https://cdn.example.com/intro.m4a"
    },
    {
      "path": "props.subtitleUrl",
      "equals": "https://cdn.example.com/subtitles.srt"
    },
    {
      "path": "props.subtitleOffsetMs",
      "equals": 250
    },
    {
      "path": "props.fit",
      "equals": "contain"
    },
    {
      "path": "props.autoPlay",
      "equals": false
    },
    {
      "path": "props.loop",
      "equals": false
    }
  ]
}