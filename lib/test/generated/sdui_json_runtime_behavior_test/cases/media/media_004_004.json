{
  "__meta": {
    "id": "media-004-avatar",
    "title": "media avatar keeps source, size, and compression props",
    "description": "Avatar surfaces should preserve source, sizing, and quality settings so the runtime can render the same asset consistently.",
    "tags": [
      "media",
      "avatar",
      "image",
      "props"
    ],
    "allowBlank": false,
    "priority": "normal"
  },
  "input": {
    "type": "media",
    "props": {
      "__subType": "avatar",
      "src": "https://cdn.example.com/avatar.png",
      "size": 72,
      "quality": 92,
      "placeholderBase64": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAAB"
    }
  },
  "expected": {
    "type": "media",
    "props": {
      "__subType": "avatar",
      "src": "https://cdn.example.com/avatar.png",
      "size": 72,
      "quality": 92,
      "placeholderBase64": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAAB"
    },
    "debugPath": "root"
  },
  "runtimeAssertions": [
    {
      "path": "props.__subType",
      "equals": "avatar"
    },
    {
      "path": "props.src",
      "equals": "https://cdn.example.com/avatar.png"
    },
    {
      "path": "props.size",
      "equals": 72
    },
    {
      "path": "props.quality",
      "equals": 92
    },
    {
      "path": "props.placeholderBase64",
      "startsWith": "iVBOR"
    }
  ]
}