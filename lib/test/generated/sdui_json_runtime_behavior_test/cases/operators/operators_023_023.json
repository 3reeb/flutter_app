{
  "__meta": {
    "id": "operators-023-stream-023",
    "title": "Stream binding becomes data:stream #023",
    "description": "The $stream operator should emit a data:stream node with the child preserved.",
    "tags": [
      "operators",
      "stream",
      "binding"
    ],
    "allowBlank": false
  },
  "input": {
    "$stream": {
      "bind": "feeds.users_5",
      "as": "entry"
    },
    "children": [
      {
        "type": "text",
        "props": {
          "text": "Stream 023"
        }
      }
    ]
  },
  "expected": {
    "type": "data",
    "props": {
      "__subType": "stream",
      "bind": "feeds.users_5",
      "as": "entry"
    },
    "debugPath": "root",
    "children": [
      {
        "type": "text",
        "props": {
          "text": "Stream 023"
        },
        "debugPath": "root[0]"
      }
    ]
  }
}
