{
  "__meta": {
    "id": "ds-030-data-stream-channel",
    "title": "data:stream with channel prop compiles correctly",
    "description": "A stream node must have __subType:stream injected and carry the channel identifier and debounceMs. The stream_core uses channel to subscribe to the event bus.",
    "tags": ["data_state", "data", "stream", "channel"],
    "allowBlank": false,
    "priority": "high"
  },
  "input": {
    "type": "data:stream",
    "props": {
      "channel": "orders.live",
      "as": "order",
      "debounceMs": 200
    },
    "children": [
      { "type": "text", "props": { "text": "${order.status}" } }
    ]
  },
  "expected": {
    "type": "data",
    "props": {
      "__subType": "stream",
      "channel": "orders.live",
      "as": "order",
      "debounceMs": 200
    },
    "debugPath": "root",
    "children": [
      { "type": "text", "props": { "text": "${order.status}" }, "debugPath": "root[0]" }
    ]
  }
}
