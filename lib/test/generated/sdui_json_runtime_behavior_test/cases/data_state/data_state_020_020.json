{
  "__meta": {
    "id": "ds-020-data-slice-offset-limit",
    "title": "data:slice with offset and limit compiles correctly",
    "description": "Slice node must have __subType:slice injected and carry bind, offset, and limit. The pipeline uses these to window the data array.",
    "tags": ["data_state", "data", "slice"],
    "allowBlank": false,
    "priority": "high"
  },
  "input": {
    "type": "data:slice",
    "props": {
      "bind": "${state.results}",
      "offset": 10,
      "limit": 5
    },
    "children": [
      { "type": "text", "props": { "text": "${item.label}" } }
    ]
  },
  "expected": {
    "type": "data",
    "props": {
      "__subType": "slice",
      "bind": "${state.results}",
      "offset": 10,
      "limit": 5
    },
    "debugPath": "root",
    "children": [
      { "type": "text", "props": { "text": "${item.label}" }, "debugPath": "root[0]" }
    ]
  }
}
