{
  "__meta": {
    "id": "ds-011-data-repeat-card-template",
    "title": "data:repeat with nested card template preserves full tree",
    "description": "A repeat whose template contains nested layout (row + avatar + col + two texts) must preserve the full tree structure. All item binding expressions must pass through verbatim.",
    "tags": ["data_state", "data", "repeat", "template", "nested"],
    "allowBlank": false,
    "priority": "high"
  },
  "input": {
    "type": "data:repeat",
    "props": { "bind": "${state.users}", "as": "user", "indexAs": "idx" },
    "children": [
      {
        "type": "box:row",
        "style": "gap-3 p-4 items-center",
        "children": [
          { "type": "media", "props": { "__subType": "avatar", "src": "${user.avatar}", "size": 40 } },
          {
            "type": "box:col",
            "children": [
              { "type": "text", "props": { "text": "${user.name}" } },
              { "type": "text", "props": { "text": "${user.email}" }, "style": "text-slate-500" }
            ]
          }
        ]
      }
    ]
  },
  "expected": {
    "type": "data",
    "props": { "__subType": "repeat", "bind": "${state.users}", "as": "user", "indexAs": "idx" },
    "debugPath": "root",
    "children": [
      {
        "type": "box:row",
        "props": {},
        "debugPath": "root[0]",
        "style": "gap-3 p-4 items-center",
        "children": [
          { "type": "media", "props": { "__subType": "avatar", "src": "${user.avatar}", "size": 40 }, "debugPath": "root[0][0]" },
          {
            "type": "box:col",
            "props": {},
            "debugPath": "root[0][1]",
            "children": [
              { "type": "text", "props": { "text": "${user.name}" }, "debugPath": "root[0][1][0]" },
              { "type": "text", "props": { "text": "${user.email}" }, "debugPath": "root[0][1][1]", "style": "text-slate-500" }
            ]
          }
        ]
      }
    ]
  }
}
