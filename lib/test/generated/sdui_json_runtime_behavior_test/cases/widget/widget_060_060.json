{
  "__meta": {
    "id": "widget-060-rotate-angle-constraints",
    "title": "Rotatable widget with angle, minAngle, maxAngle compiles correctly",
    "description": "A widget with rotatable:true must carry the initial angle plus min/max angle constraints. The runtime uses these to clamp rotation during a rotate gesture. Missing angle defaults to 0; missing min/max removes constraint (free spin).",
    "tags": ["widget", "rotate", "angle", "constraints"],
    "allowBlank": false,
    "priority": "critical"
  },
  "input": {
    "type": "box:col",
    "props": {
      "rotatable": true,
      "angle": 45.0,
      "minAngle": -90.0,
      "maxAngle": 90.0,
      "snapAngle": 15.0
    },
    "children": [
      { "type": "text", "props": { "text": "Rotate me" } }
    ]
  },
  "expected": {
    "type": "box:col",
    "props": {
      "rotatable": true,
      "angle": 45.0,
      "minAngle": -90.0,
      "maxAngle": 90.0,
      "snapAngle": 15.0
    },
    "debugPath": "root",
    "children": [
      { "type": "text", "props": { "text": "Rotate me" }, "debugPath": "root[0]" }
    ]
  },
  "runtimeAssertions": [
    { "path": "props.rotatable",  "equals": true },
    { "path": "props.angle",      "equals": 45.0 },
    { "path": "props.minAngle",   "equals": -90.0 },
    { "path": "props.maxAngle",   "equals": 90.0 },
    { "path": "props.snapAngle",  "equals": 15.0 },
    { "path": "type",             "equals": "box:col" },
    { "path": "children.length",  "equals": 1 }
  ],
  "runtimeBehavior": {
    "gesture":              "rotate",
    "description":          "Starting at angle 45°, rotating +60° gives 90° (clamped at maxAngle). Rotating -150° gives -90° (clamped at minAngle). SnapAngle:15 snaps to nearest 15° increment.",
    "initialAngle":         45.0,
    "gestureRotateDelta":   60.0,
    "expectedResultAngle":  90.0,
    "clampedByMaxAngle":    true,
    "snapAngle":            15.0,
    "expectedSnappedAngle": 90.0
  }
}
