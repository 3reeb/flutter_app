{
  "__meta": {
    "id": "widget-063-drag-and-resize-combined",
    "title": "Widget that is both draggable and resizable compiles correctly",
    "description": "A widget can be both draggable and resizable simultaneously. Both prop sets must survive compilation together. The runtime activates drag on the handle-free area and resize on handles. They must not conflict.",
    "tags": ["widget", "drag", "resize", "combined"],
    "allowBlank": false,
    "priority": "high"
  },
  "input": {
    "type": "box:col",
    "props": {
      "draggable": true,
      "dragAxis": "both",
      "resizable": true,
      "handles": ["n", "s", "e", "w", "ne", "nw", "se", "sw"],
      "width": 320,
      "height": 240,
      "minWidth": 100,
      "minHeight": 80,
      "maxWidth": 1200,
      "maxHeight": 900,
      "snapToGrid": true,
      "gridSize": 8
    },
    "children": [
      { "type": "text", "props": { "text": "Drag + Resize me" } }
    ]
  },
  "expected": {
    "type": "box:col",
    "props": {
      "draggable": true,
      "dragAxis": "both",
      "resizable": true,
      "handles": ["n", "s", "e", "w", "ne", "nw", "se", "sw"],
      "width": 320,
      "height": 240,
      "minWidth": 100,
      "minHeight": 80,
      "maxWidth": 1200,
      "maxHeight": 900,
      "snapToGrid": true,
      "gridSize": 8
    },
    "debugPath": "root",
    "children": [
      { "type": "text", "props": { "text": "Drag + Resize me" }, "debugPath": "root[0]" }
    ]
  },
  "runtimeAssertions": [
    { "path": "props.draggable",       "equals": true },
    { "path": "props.resizable",       "equals": true },
    { "path": "props.dragAxis",        "equals": "both" },
    { "path": "props.handles.length",  "equals": 8 },
    { "path": "props.handles[4]",      "equals": "ne" },
    { "path": "props.handles[5]",      "equals": "nw" },
    { "path": "props.handles[6]",      "equals": "se" },
    { "path": "props.handles[7]",      "equals": "sw" },
    { "path": "props.width",           "equals": 320 },
    { "path": "props.height",          "equals": 240 },
    { "path": "props.minWidth",        "lessThan": 320 },
    { "path": "props.minHeight",       "lessThan": 240 },
    { "path": "props.maxWidth",        "greaterThan": 320 },
    { "path": "props.maxHeight",       "greaterThan": 240 },
    { "path": "props.snapToGrid",      "equals": true },
    { "path": "props.gridSize",        "equals": 8 }
  ],
  "runtimeBehavior": {
    "gesture":         "drag+resize",
    "description":     "Body drag moves widget. Handle drag resizes it. Grid snapping at 8px increments applies to both drag position and resize dimension. A drag of 12px snaps to 8px; 20px snaps to 24px.",
    "dragDelta":       12,
    "expectedSnapped": 8,
    "resizeDelta":     20,
    "expectedResizeSnapped": 24
  }
}
