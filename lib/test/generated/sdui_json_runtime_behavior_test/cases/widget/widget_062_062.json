{
  "__meta": {
    "id": "widget-062-resize-with-lifecycle-handlers",
    "title": "Resizable widget with onResizeStart, onResizeEnd, and min/max constraints",
    "description": "A resizable widget must carry onResizeStart, onResizeEnd handlers and min/max dimension constraints. The runtime clamps resize operations to minWidth/maxWidth/minHeight/maxHeight. onResizeEnd receives the final dimensions. Missing handlers means no callbacks; missing constraints means unconstrained resize.",
    "tags": ["widget", "resize", "handlers", "constraints", "action"],
    "allowBlank": false,
    "priority": "critical"
  },
  "input": {
    "type": "box:col",
    "props": {
      "resizable": true,
      "handles": ["e", "w", "s", "se"],
      "width": 400,
      "height": 300,
      "minWidth": 200,
      "maxWidth": 800,
      "minHeight": 150,
      "maxHeight": 600,
      "onResizeStart": { "type": "action", "name": "resize.start" },
      "onResizeEnd":   { "type": "action", "name": "resize.end", "args": { "emitDimensions": true } }
    },
    "children": [
      { "type": "text", "props": { "text": "Resize panel" } }
    ]
  },
  "expected": {
    "type": "box:col",
    "props": {
      "resizable": true,
      "handles": ["e", "w", "s", "se"],
      "width": 400,
      "height": 300,
      "minWidth": 200,
      "maxWidth": 800,
      "minHeight": 150,
      "maxHeight": 600,
      "onResizeStart": { "type": "action", "name": "resize.start" },
      "onResizeEnd":   { "type": "action", "name": "resize.end", "args": { "emitDimensions": true } }
    },
    "debugPath": "root",
    "children": [
      { "type": "text", "props": { "text": "Resize panel" }, "debugPath": "root[0]" }
    ]
  },
  "runtimeAssertions": [
    { "path": "props.resizable",                    "equals": true },
    { "path": "props.handles[0]",                   "equals": "e" },
    { "path": "props.handles[1]",                   "equals": "w" },
    { "path": "props.handles[2]",                   "equals": "s" },
    { "path": "props.handles[3]",                   "equals": "se" },
    { "path": "props.handles.length",               "equals": 4 },
    { "path": "props.width",                        "equals": 400 },
    { "path": "props.height",                       "equals": 300 },
    { "path": "props.minWidth",                     "greaterThan": 0 },
    { "path": "props.minWidth",                     "equals": 200 },
    { "path": "props.maxWidth",                     "equals": 800 },
    { "path": "props.minHeight",                    "equals": 150 },
    { "path": "props.maxHeight",                    "equals": 600 },
    { "path": "props.onResizeStart.type",           "equals": "action" },
    { "path": "props.onResizeStart.name",           "equals": "resize.start" },
    { "path": "props.onResizeEnd.name",             "equals": "resize.end" },
    { "path": "props.onResizeEnd.args.emitDimensions", "equals": true }
  ],
  "runtimeBehavior": {
    "gesture":              "resize",
    "description":          "Dragging the east handle 100px right changes width from 400 to 500 (clamped at maxWidth:800). Dragging west handle past 200px clamps at minWidth:200. onResizeEnd fires with {width: final, height: final}.",
    "handle":               "e",
    "dragDeltaX":           100,
    "initialWidth":         400,
    "expectedWidth":        500,
    "clampMax":             800,
    "lifecycleEvents":      ["onResizeStart", "onResizeEnd"],
    "onResizeEndPayload":   { "width": 500, "height": 300 }
  }
}
