{
  "__meta": {
    "id": "widget-020-resizable-handles",
    "title": "Resizable box with all 8 handles and min/max compiles correctly",
    "description": "A resizable box must carry resizable:true, all 8 directional handles, and min/max size bounds. Missing handles silently drops resize directions. Missing min/max allows zero or infinite size.",
    "tags": ["widget", "resize", "handles", "bounds"],
    "allowBlank": false,
    "priority": "critical"
  },
  "input": {
    "type": "box:col",
    "props": {
      "resizable": true,
      "handles": ["n", "s", "e", "w", "ne", "nw", "se", "sw"],
      "minWidth": 120,
      "minHeight": 80,
      "maxWidth": 800,
      "maxHeight": 600
    },
    "children": [
      { "type": "text", "props": { "text": "Resize me" } }
    ]
  },
  "expected": {
    "type": "box:col",
    "props": {
      "resizable": true,
      "handles": ["n", "s", "e", "w", "ne", "nw", "se", "sw"],
      "minWidth": 120,
      "minHeight": 80,
      "maxWidth": 800,
      "maxHeight": 600
    },
    "debugPath": "root",
    "children": [
      { "type": "text", "props": { "text": "Resize me" }, "debugPath": "root[0]" }
    ]
  },
  "runtimeAssertions": [
    { "path": "props.resizable",      "equals": true },
    { "path": "props.handles.length", "equals": 8 },
    { "path": "props.handles[0]",     "equals": "n" },
    { "path": "props.handles[1]",     "equals": "s" },
    { "path": "props.handles[2]",     "equals": "e" },
    { "path": "props.handles[3]",     "equals": "w" },
    { "path": "props.handles[4]",     "equals": "ne" },
    { "path": "props.handles[5]",     "equals": "nw" },
    { "path": "props.handles[6]",     "equals": "se" },
    { "path": "props.handles[7]",     "equals": "sw" },
    { "path": "props.minWidth",       "equals": 120 },
    { "path": "props.minHeight",      "equals": 80 },
    { "path": "props.maxWidth",       "equals": 800 },
    { "path": "props.maxHeight",      "equals": 600 },
    { "path": "props.minWidth",       "greaterThan": 0 },
    { "path": "props.maxWidth",       "greaterThan": 120 },
    { "path": "children.length",      "equals": 1 }
  ],
  "runtimeBehavior": {
    "gesture":         "resize",
    "description":     "All 8 handles active. Dragging 'e' handle 200px right: new width = current + 200 (clamped at maxWidth:800). Dragging 's' handle -100px up: new height = current - 100 (clamped at minHeight:80). Corner handles change both dimensions simultaneously.",
    "handles":         ["n", "s", "e", "w", "ne", "nw", "se", "sw"],
    "eastDragDelta":   200,
    "expectedWidthChange": "+200 (capped at maxWidth 800)",
    "southDragDelta":  -100,
    "expectedHeightChange": "-100 (floored at minHeight 80)",
    "cornerDiagonal":  "ne handle drag changes both width and height proportionally"
  }
}
