{
  "__meta": {
    "id": "widget-010-draggable-prop",
    "title": "draggable prop on box node compiles verbatim",
    "description": "A box with draggable:true must carry that prop plus dragAxis and dragHandleSelector in the compiled blueprint. Missing any of these silently disables drag behavior.",
    "tags": ["widget", "drag", "props"],
    "allowBlank": false,
    "priority": "critical"
  },
  "input": {
    "type": "box:col",
    "props": {
      "draggable": true,
      "dragAxis": "both",
      "dragHandleSelector": ".drag-handle"
    },
    "children": [
      { "type": "text", "props": { "text": "Drag me" } }
    ]
  },
  "expected": {
    "type": "box:col",
    "props": {
      "draggable": true,
      "dragAxis": "both",
      "dragHandleSelector": ".drag-handle"
    },
    "debugPath": "root",
    "children": [
      { "type": "text", "props": { "text": "Drag me" }, "debugPath": "root[0]" }
    ]
  },
  "runtimeAssertions": [
    { "path": "props.draggable",           "equals": true },
    { "path": "props.dragAxis",            "equals": "both" },
    { "path": "props.dragAxis",            "oneOf": ["x", "y", "both"] },
    { "path": "props.dragHandleSelector",  "equals": ".drag-handle" },
    { "path": "props.dragHandleSelector",  "startsWith": "." },
    { "path": "type",                      "equals": "box:col" },
    { "path": "children.length",           "equals": 1 }
  ],
  "runtimeBehavior": {
    "gesture":         "drag",
    "description":     "With dragAxis:both, the widget can move freely in X and Y. dragHandleSelector:.drag-handle restricts the drag trigger area to elements matching that CSS selector. Dragging outside the handle does not initiate drag.",
    "axis":            "both",
    "handleSelector":  ".drag-handle",
    "dragFromHandle":  true,
    "dragFromBody":    false,
    "deltaX":          50,
    "deltaY":          30,
    "expectedOffsetX": 50,
    "expectedOffsetY": 30
  }
}
