{
  "__meta": {
    "id": "widget-061-drag-with-handlers",
    "title": "Draggable widget with onDragStart and onDragEnd action handlers",
    "description": "A drag-enabled widget must carry both onDragStart and onDragEnd alongside the core draggable props. These handlers are invoked by the runtime when the gesture begins and ends. Missing either breaks drag lifecycle callbacks.",
    "tags": ["widget", "drag", "handlers", "action"],
    "allowBlank": false,
    "priority": "critical"
  },
  "input": {
    "type": "box:col",
    "props": {
      "draggable": true,
      "dragAxis": "both",
      "initialX": 0,
      "initialY": 0,
      "onDragStart": { "type": "action", "name": "drag.start" },
      "onDragEnd":   { "type": "action", "name": "drag.end", "args": { "persist": true } },
      "onDragUpdate": { "type": "action", "name": "drag.update" }
    },
    "children": [
      { "type": "text", "props": { "text": "Draggable card" } }
    ]
  },
  "expected": {
    "type": "box:col",
    "props": {
      "draggable": true,
      "dragAxis": "both",
      "initialX": 0,
      "initialY": 0,
      "onDragStart":  { "type": "action", "name": "drag.start" },
      "onDragEnd":    { "type": "action", "name": "drag.end", "args": { "persist": true } },
      "onDragUpdate": { "type": "action", "name": "drag.update" }
    },
    "debugPath": "root",
    "children": [
      { "type": "text", "props": { "text": "Draggable card" }, "debugPath": "root[0]" }
    ]
  },
  "runtimeAssertions": [
    { "path": "props.draggable",              "equals": true },
    { "path": "props.dragAxis",               "oneOf": ["x", "y", "both"] },
    { "path": "props.dragAxis",               "equals": "both" },
    { "path": "props.initialX",               "equals": 0 },
    { "path": "props.initialY",               "equals": 0 },
    { "path": "props.onDragStart.type",       "equals": "action" },
    { "path": "props.onDragStart.name",       "equals": "drag.start" },
    { "path": "props.onDragEnd.type",         "equals": "action" },
    { "path": "props.onDragEnd.name",         "equals": "drag.end" },
    { "path": "props.onDragEnd.args.persist", "equals": true },
    { "path": "props.onDragUpdate.name",      "equals": "drag.update" },
    { "path": "children.length",              "equals": 1 }
  ],
  "runtimeBehavior": {
    "gesture":            "drag",
    "description":        "Dragging 100px right, 50px down: onDragStart fires at gesture start. onDragUpdate fires per frame with {dx, dy}. onDragEnd fires at release with final {dx:100, dy:50}.",
    "axis":               "both",
    "deltaX":             100,
    "deltaY":             50,
    "expectedOffsetX":    100,
    "expectedOffsetY":    50,
    "lifecycleEvents":    ["onDragStart", "onDragUpdate × N", "onDragEnd"],
    "onDragEndPayload":   { "dx": 100, "dy": 50 }
  }
}
