{
  "__meta": {
    "id": "action-021-double-tap",
    "title": "action:double_tap onDoubleTap prop compiles correctly",
    "description": "The double_tap subtype must inject __subType:double_tap and carry the onDoubleTap handler descriptor intact.",
    "tags": ["action", "double_tap"],
    "allowBlank": false,
    "priority": "medium"
  },
  "input": {
    "type": "action:double_tap",
    "props": {
      "onDoubleTap": { "type": "action", "name": "like.toggle" }
    },
    "children": [
      { "type": "media", "props": { "__subType": "icon", "name": "heart" } }
    ]
  },
  "expected": {
    "type": "action",
    "props": {
      "__subType": "double_tap",
      "onDoubleTap": { "type": "action", "name": "like.toggle" }
    },
    "debugPath": "root",
    "children": [
      { "type": "media", "props": { "__subType": "icon", "name": "heart" }, "debugPath": "root[0].heart" }
    ]
  }
}
