{
  "__meta": {
    "id": "action-090-bare-action-type",
    "title": "Plain 'action' type with no __subType compiles without error",
    "description": "When type:'action' is used with no __subType, the VM must not inject one. The action_core uses the gesture default path.",
    "tags": ["action", "fallback", "gesture"],
    "allowBlank": false,
    "priority": "medium"
  },
  "input": {
    "type": "action",
    "props": {
      "onTap": { "type": "action", "name": "do.something" }
    },
    "children": [
      { "type": "text", "props": { "text": "Click me" } }
    ]
  },
  "expected": {
    "type": "action",
    "props": {
      "onTap": { "type": "action", "name": "do.something" }
    },
    "debugPath": "root",
    "children": [
      { "type": "text", "props": { "text": "Click me" }, "debugPath": "root[0]" }
    ]
  }
}
