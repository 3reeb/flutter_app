{
  "name": "public_shell",
  "mode": "shell",
  "viewport": "responsive",
  "scaffold": true,
  "safeArea": "all",
  "slots": {
    "header": {
      "scrollable": false
    },
    "content": {
      "scrollable": true
    },
    "footer": {
      "scrollable": false
    }
  },
  "meta": {
    "name": "public",
    "layer": "shell"
  },
  "kind": "layout",
  "type": "layout",
  "ui": {
    "type": "page_shell",
    "props": {
      "title": "Public",
      "compact": false,
      "showSidebar": false,
      "showFooter": true
    },
    "slots": {
      "header": {
        "type": "box",
        "props": {
          "padding": 24
        },
        "children": [
          {
            "type": "component:use",
            "props": {
              "component": "page_header",
              "title": "Quantum",
              "subtitle": "The fastest SDUI runtime"
            },
            "children": []
          }
        ]
      },
      "content": {
        "type": "box",
        "props": {
          "direction": "col",
          "gap": 24,
          "padding": 24
        },
        "children": [
          {
            "type": "text",
            "props": {
              "text": "Content area"
            },
            "children": []
          }
        ]
      },
      "footer": {
        "type": "box",
        "props": {
          "padding": 24
        },
        "children": [
          {
            "type": "text",
            "props": {
              "text": "© Quantum"
            },
            "children": []
          }
        ]
      }
    }
  }
}