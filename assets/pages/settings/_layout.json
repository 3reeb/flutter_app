{
  "name": "dashboard_shell",
  "mode": "shell",
  "viewport": "responsive",
  "scaffold": true,
  "safeArea": "all",
  "slots": {
    "sidebar": {
      "scrollable": true,
      "sticky": true
    },
    "content": {
      "scrollable": true
    }
  },
  "meta": {
    "name": "dashboard",
    "layer": "shell"
  },
  "kind": "layout",
  "type": "layout",
  "ui": {
    "type": "page_shell",
    "props": {
      "title": "Dashboard",
      "compact": false,
      "showSidebar": true,
      "showFooter": false
    },
    "slots": {
      "sidebar": {
        "type": "box",
        "_node": {
          "type": "component:render",
          "props": {
            "__componentName": "nav_rail",
            "current": "/dashboard",
            "collapsed": false
          },
          "children": [
            {
              "_node": {
                "type": "box",
                "props": {
                  "direction": "col",
                  "gap": 8,
                  "padding": 16,
                  "radius": 20,
                  "bg": "$colors.surface"
                },
                "children": [
                  {
                    "_node": {
                      "type": "text",
                      "props": {
                        "text": "Navigation"
                      },
                      "children": []
                    }
                  },
                  {
                    "_node": {
                      "type": "text",
                      "props": {
                        "text": "/dashboard"
                      },
                      "children": []
                    }
                  }
                ]
              }
            }
          ],
          "__componentName": "nav_rail"
        }
      },
      "content": {
        "type": "box",
        "_node": {
          "type": "box",
          "props": {
            "direction": "col",
            "gap": 24,
            "padding": 24
          },
          "children": []
        }
      }
    }
  }
}