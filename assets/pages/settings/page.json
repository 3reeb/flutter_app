{
  "kind": "page",
  "type": "route",
  "name": "settings",
  "id": "settings",
  "path": "/settings",
  "guards": [
    {
      "type": "redirect",
      "condition": "auth.isAuthenticated",
      "to": "/login"
    }
  ],
  "meta": {
    "title": "Settings | Quantum",
    "description": "Full settings surface.",
    "custom": {
      "area": "app"
    }
  },
  "routeId": "settings",
  "ui": {
    "type": "box",
    "props": {
      "direction": "col",
      "gap": 24
    },
    "children": [
      {
        "type": "component:use",
        "props": {
          "component": "page_header",
          "title": "Settings",
          "subtitle": "Profile, security, and preferences"
        },
        "children": []
      },
      {
        "type": "template:section",
        "props": {
          "title": "Account",
          "description": "Manage your account details.",
          "compact": false,
          "name": "section"
        },
        "children": []
      }
    ]
  }
}