{
  "name": "docs_shell",
  "mode": "matrix",
  "viewport": "responsive",
  "scaffold": true,
  "safeArea": "all",
  "kind": "layout",
  "type": "layout",
  "ui": {
    "type": "page_shell",
    "props": {
      "title": "Docs",
      "compact": false,
      "showSidebar": true,
      "showFooter": true
    },
    "slots": {
      "sidebar": {
        "type": "box",
        "_node": {
          "type": "component:render",
          "props": {
            "__componentName": "nav_rail",
            "current": "/docs",
            "collapsed": false
          },
          "children": [
            {
              "_node": {
                "type": "box",
                "props": {
                  "direction": "col",
                  "gap": 8,
                  "padding": 16,
                  "radius": 20,
                  "bg": "$colors.surface"
                },
                "children": [
                  {
                    "_node": {
                      "type": "text",
                      "props": {
                        "text": "Navigation"
                      },
                      "children": []
                    }
                  },
                  {
                    "_node": {
                      "type": "text",
                      "props": {
                        "text": "/docs"
                      },
                      "children": []
                    }
                  }
                ]
              }
            }
          ],
          "__componentName": "nav_rail"
        }
      },
      "content": {
        "type": "box",
        "_node": {
          "type": "box",
          "props": {
            "direction": "col",
            "gap": 20,
            "padding": 24
          },
          "children": []
        }
      },
      "footer": {
        "type": "box",
        "_node": {
          "type": "box",
          "props": {
            "padding": 16
          },
          "children": [
            {
              "_node": {
                "type": "text",
                "props": {
                  "text": "Built with Quantum"
                },
                "children": []
              }
            }
          ]
        }
      }
    }
  }
}