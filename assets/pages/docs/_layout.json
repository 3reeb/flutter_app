{
  "name": "docs_shell",
  "mode": "matrix",
  "viewport": "responsive",
  "scaffold": true,
  "safeArea": "all",
  "kind": "layout",
  "type": "layout",
  "ui": {
    "type": "page_shell",
    "props": {
      "title": "Docs",
      "compact": false,
      "showSidebar": true,
      "showFooter": true
    },
    "slots": {
      "sidebar": {
        "type": "component:use",
        "props": {
          "component": "nav_rail",
          "current": "/docs",
          "collapsed": false
        },
        "children": []
      },
      "content": {
        "type": "box",
        "props": {
          "direction": "col",
          "gap": 20,
          "padding": 24
        },
        "children": [
          {
            "type": "text",
            "props": {
              "text": "Docs content"
            },
            "children": []
          }
        ]
      },
      "footer": {
        "type": "box",
        "props": {
          "padding": 16
        },
        "children": [
          {
            "type": "text",
            "props": {
              "text": "Built with Quantum"
            },
            "children": []
          }
        ]
      }
    }
  }
}