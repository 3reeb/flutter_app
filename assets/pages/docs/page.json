{
  "kind": "page",
  "type": "route",
  "name": "docs",
  "id": "docs",
  "path": "/docs",
  "prefetch": {
    "routes": [
      "/docs/getting-started",
      "/docs/api",
      "/docs/guides"
    ],
    "layout": true,
    "fragments": [
      "docs_index"
    ],
    "priority": "normal",
    "viewport": "visible"
  },
  "meta": {
    "title": "Docs | Quantum",
    "description": "Nested docs with route-aware layouts and fragments.",
    "custom": {
      "area": "docs"
    }
  },
  "routeId": "docs",
  "ui": {
    "type": "box",
    "props": {
      "direction": "col",
      "gap": 24
    },
    "children": [
      {
        "type": "component:use",
        "props": {
          "component": "page_header",
          "title": "Documentation",
          "subtitle": "A nested, route-driven knowledge surface"
        },
        "children": []
      },
      {
        "type": "template:section",
        "props": {
          "title": "Start here",
          "description": "Explore nested docs pages with layout inheritance.",
          "compact": false,
          "name": "section"
        },
        "children": []
      }
    ]
  }
}