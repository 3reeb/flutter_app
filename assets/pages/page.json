{
  "kind": "page",
  "type": "route",
  "name": "home",
  "id": "home",
  "path": "/",
  "prefetch": {
    "routes": [
      "/dashboard",
      "/docs"
    ],
    "layout": true,
    "priority": "high",
    "viewport": "idle"
  },
  "meta": {
    "title": "Quantum",
    "description": "A powerful SDUI runtime for Flutter and JSON render graphs.",
    "custom": {
      "area": "marketing",
      "kind": "landing"
    }
  },
  "routeId": "home",
  "ui": {
    "type": "template:hero",
    "props": {
      "eyebrow": "Introducing",
      "title": "Build anything with one JSON graph",
      "body": "Pages, layouts, fragments, guards, pipelines, and nested routes all compile into a fast Flutter render tree.",
      "primaryLabel": "Start",
      "secondaryLabel": "Docs",
      "name": "hero"
    },
    "slots": {
      "actions": {
        "type": "box",
        "props": {
          "direction": "row",
          "gap": 12
        },
        "children": [
          {
            "type": "action",
            "props": {
              "text": "Get Started",
              "intent": "primary",
              "variant": "solid"
            },
            "children": []
          },
          {
            "type": "action",
            "props": {
              "text": "Read Docs",
              "intent": "ghost",
              "variant": "outline"
            },
            "children": []
          }
        ]
      }
    }
  }
}