{
  "name": "dashboard_shell",
  "mode": "shell",
  "viewport": "responsive",
  "scaffold": true,
  "safeArea": "all",
  "slots": {
    "sidebar": {
      "scrollable": true,
      "sticky": true
    },
    "content": {
      "scrollable": true
    }
  },
  "meta": {
    "name": "dashboard",
    "layer": "shell"
  },
  "kind": "layout",
  "type": "layout",
  "ui": {
    "type": "page_shell",
    "props": {
      "title": "Dashboard",
      "compact": false,
      "showSidebar": true,
      "showFooter": false
    },
    "slots": {
      "sidebar": {
        "type": "component:use",
        "props": {
          "component": "nav_rail",
          "current": "/dashboard",
          "collapsed": false
        },
        "children": []
      },
      "content": {
        "type": "box",
        "props": {
          "direction": "col",
          "gap": 24,
          "padding": 24
        },
        "children": []
      }
    }
  }
}