{
  "comment": "Supabase Configuration - Replace with your actual project details",
  "projectUrl": "https://your-project-id.supabase.co",
  "anonKey": "YOUR_SUPABASE_ANON_KEY",
  "serviceKey": "YOUR_SUPABASE_SERVICE_KEY",
  "bucketName": "public",
  "enableRealtime": true,
  "features": {
    "auth": {
      "enabled": true,
      "providers": ["email_password", "google", "github", "apple"]
    },
    "database": {
      "enabled": true,
      "tables": ["posts", "profiles", "messages", "tasks", "follows"]
    },
    "storage": {
      "enabled": true,
      "buckets": ["public", "avatars", "uploads"]
    },
    "realtime": {
      "enabled": true,
      "channels": ["posts", "messages", "notifications"]
    }
  },
  "tables": {
    "posts": {
      "columns": [
        {"name": "id", "type": "uuid", "primaryKey": true},
        {"name": "user_id", "type": "uuid", "foreignKey": "profiles(id)"},
        {"name": "title", "type": "text", "required": true},
        {"name": "content", "type": "text", "required": true},
        {"name": "tags", "type": "jsonb", "required": false},
        {"name": "created_at", "type": "timestamp", "defaultValue": "now()"},
        {"name": "updated_at", "type": "timestamp", "defaultValue": "now()"},
        {"name": "deleted_at", "type": "timestamp", "required": false}
      ],
      "policies": {
        "read": "public",
        "create": "authenticated",
        "update": "own_records",
        "delete": "own_records"
      }
    },
    "profiles": {
      "columns": [
        {"name": "id", "type": "uuid", "primaryKey": true},
        {"name": "user_id", "type": "uuid", "foreignKey": "auth.users(id)"},
        {"name": "name", "type": "text", "required": false},
        {"name": "avatar_url", "type": "text", "required": false},
        {"name": "bio", "type": "text", "required": false},
        {"name": "website", "type": "text", "required": false},
        {"name": "created_at", "type": "timestamp", "defaultValue": "now()"},
        {"name": "updated_at", "type": "timestamp", "defaultValue": "now()"}
      ],
      "policies": {
        "read": "public",
        "create": "authenticated",
        "update": "own_records"
      }
    },
    "messages": {
      "columns": [
        {"name": "id", "type": "uuid", "primaryKey": true},
        {"name": "chat_id", "type": "uuid", "required": true},
        {"name": "user_id", "type": "uuid", "foreignKey": "profiles(id)"},
        {"name": "content", "type": "text", "required": true},
        {"name": "created_at", "type": "timestamp", "defaultValue": "now()"}
      ],
      "policies": {
        "read": "chat_members",
        "create": "authenticated",
        "delete": "own_records"
      }
    },
    "tasks": {
      "columns": [
        {"name": "id", "type": "uuid", "primaryKey": true},
        {"name": "user_id", "type": "uuid", "foreignKey": "profiles(id)"},
        {"name": "title", "type": "text", "required": true},
        {"name": "completed", "type": "boolean", "defaultValue": false},
        {"name": "created_at", "type": "timestamp", "defaultValue": "now()"},
        {"name": "updated_at", "type": "timestamp", "defaultValue": "now()"}
      ],
      "policies": {
        "read": "own_records",
        "create": "authenticated",
        "update": "own_records",
        "delete": "own_records"
      }
    },
    "follows": {
      "columns": [
        {"name": "id", "type": "uuid", "primaryKey": true},
        {"name": "follower_id", "type": "uuid", "foreignKey": "profiles(id)"},
        {"name": "following_id", "type": "uuid", "foreignKey": "profiles(id)"},
        {"name": "created_at", "type": "timestamp", "defaultValue": "now()"}
      ],
      "policies": {
        "read": "public",
        "create": "authenticated",
        "delete": "own_records"
      }
    }
  },
  "setupInstructions": {
    "step1": "Create a new project at https://app.supabase.com",
    "step2": "Copy your Project URL and Anon Key from the project settings",
    "step3": "Update this configuration file with your credentials",
    "step4": "Run 'flutter pub get' to install Supabase packages",
    "step5": "Use SupabaseEnvironment.loadFromJson() to initialize",
    "step6": "Run database migrations in the Supabase console"
  }
}
