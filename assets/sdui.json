{
  "contracts": {
    "user": {
      "_tag": "object",
      "_meta": {
        "shape": {
          "id": {
            "_tag": "string"
          },
          "name": {
            "_tag": "string"
          },
          "email": {
            "_tag": "optional",
            "_meta": {
              "inner": {
                "_tag": "string"
              }
            }
          },
          "role": {
            "_tag": "enum",
            "_meta": {
              "values": [
                "admin",
                "member",
                "guest"
              ]
            }
          },
          "avatarUrl": {
            "_tag": "optional",
            "_meta": {
              "inner": {
                "_tag": "string"
              }
            }
          }
        }
      }
    },
    "project": {
      "_tag": "object",
      "_meta": {
        "shape": {
          "id": {
            "_tag": "string"
          },
          "title": {
            "_tag": "string"
          },
          "ownerId": {
            "_tag": "string"
          },
          "status": {
            "_tag": "enum",
            "_meta": {
              "values": [
                "active",
                "paused",
                "archived"
              ]
            }
          }
        }
      }
    },
    "navItem": {
      "_tag": "object",
      "_meta": {
        "shape": {
          "label": {
            "_tag": "string"
          },
          "href": {
            "_tag": "string"
          },
          "icon": {
            "_tag": "optional",
            "_meta": {
              "inner": {
                "_tag": "string"
              }
            }
          }
        }
      }
    }
  },
  "theme": {
    "colors": {
      "brand": {
        "50": "#eef2ff",
        "100": "#e0e7ff",
        "200": "#c7d2fe",
        "300": "#a5b4fc",
        "400": "#818cf8",
        "500": "#6366f1",
        "600": "#4f46e5",
        "700": "#4338ca",
        "800": "#3730a3",
        "900": "#312e81"
      },
      "neutral": {
        "50": "#f8fafc",
        "100": "#f1f5f9",
        "200": "#e2e8f0",
        "300": "#cbd5e1",
        "400": "#94a3b8",
        "500": "#64748b",
        "600": "#475569",
        "700": "#334155",
        "800": "#1e293b",
        "900": "#0f172a"
      }
    },
    "spacing": {
      "xs": 4,
      "sm": 8,
      "md": 12,
      "lg": 16,
      "xl": 24,
      "2xl": 32
    },
    "radii": {
      "sm": 8,
      "md": 12,
      "lg": 16,
      "xl": 24,
      "full": 9999
    },
    "shadows": {
      "sm": {
        "offsetX": 0,
        "offsetY": 1,
        "blurRadius": 2,
        "color": "rgba(15, 23, 42, 0.08)"
      },
      "md": {
        "offsetX": 0,
        "offsetY": 8,
        "blurRadius": 24,
        "color": "rgba(15, 23, 42, 0.12)"
      }
    },
    "typography": {
      "h1": {
        "fontFamily": "Inter",
        "fontSize": 28,
        "fontWeight": 700,
        "lineHeight": 1.15
      },
      "body": {
        "fontFamily": "Inter",
        "fontSize": 14,
        "fontWeight": 400,
        "lineHeight": 1.5
      },
      "mono": {
        "fontFamily": "JetBrains Mono",
        "fontSize": 13,
        "fontWeight": 400,
        "lineHeight": 1.5
      }
    },
    "animations": {
      "fast": {
        "duration": 120,
        "curve": "easeOut"
      },
      "normal": {
        "duration": 220,
        "curve": "easeInOut"
      }
    },
    "breakpoints": {
      "sm": 640,
      "md": 768,
      "lg": 1024
    },
    "zIndex": {
      "base": 0,
      "dropdown": 1000,
      "modal": 1100,
      "toast": 1200
    }
  },
  "stores": {
    "auth": {
      "namespace": "app.auth",
      "state": {
        "userId": "",
        "token": "",
        "hydrated": false,
        "profile": {
          "id": "",
          "name": "",
          "email": "",
          "role": "guest",
          "avatarUrl": ""
        },
        "computed": {
          "isAuthed": {
            "deps": [
              "token"
            ],
            "expr": "{{state.token}}"
          },
          "displayName": {
            "deps": [
              "profile.name"
            ],
            "expr": "{{state.profile.name}}"
          }
        },
        "mutations": {
          "setToken": {
            "strategy": "update"
          },
          "setProfile": {
            "strategy": "merge"
          },
          "logout": {
            "strategy": "update",
            "optimistic": {
              "token": "",
              "userId": "",
              "hydrated": false
            }
          }
        },
        "queries": {
          "loadSession": {
            "op": "read",
            "resource": "/session"
          }
        }
      }
    }
  },
  "slices": {
    "feed": {
      "namespace": "app.feed",
      "schema": "feed.v1",
      "dataSource": "usersApi",
      "state": {
        "items": null,
        "page": null,
        "pageSize": null,
        "selectedId": null,
        "search": null
      },
      "computed": {
        "itemCount": {
          "deps": [
            "items"
          ],
          "op": "count"
        }
      },
      "mutations": {
        "selectItem": {
          "strategy": "update"
        },
        "addItem": {
          "strategy": "append"
        }
      },
      "protection": {
        "level": "authenticated"
      },
      "runtime": {
        "autoMount": true,
        "persist": true,
        "persistKey": "app.feed"
      }
    }
  },
  "dataSources": {
    "usersApi": {
      "name": "usersApi",
      "schemaName": "user.list.response",
      "type": "rest",
      "domain": "api_collection",
      "action": "readMany",
      "resource": "/v1/users",
      "select": [
        "id",
        "name",
        "email",
        "role",
        "avatarUrl"
      ],
      "autoStart": true,
      "smartSelect": true
    }
  },
  "templates": {
    "AppShell": {
      "name": "AppShell",
      "props": {
        "title": "string",
        "subtitle": "optional",
        "showSidebar": "optional"
      },
      "slots": [
        "header",
        "sidebar",
        "content",
        "footer"
      ],
      "ui": {
        "type": "box",
        "props": {
          "direction": "col",
          "gap": 12,
          "padding": 24,
          "radius": 16,
          "bg": "$colors.neutral.50",
          "shadow": "$shadows.md"
        },
        "children": [
          {
            "_node": {
              "type": "text",
              "props": {
                "text": "{{props.title}}",
                "variant": "heading"
              },
              "children": []
            }
          },
          {
            "_node": {
              "type": "text",
              "props": {
                "text": "{{props.subtitle}}"
              },
              "children": []
            }
          },
          null,
          null,
          null
        ]
      },
      "description": "Main application shell with typed reusable slots.",
      "tags": [
        "shell",
        "layout",
        "app"
      ],
      "metadata": {}
    }
  },
  "components": {
    "ProfileCard": {
      "name": "ProfileCard"
    }
  },
  "macros": {
    "AppFrame": {
      "name": "AppFrame",
      "body": {
        "_node": {
          "type": "box",
          "props": {
            "direction": "col",
            "gap": 12,
            "padding": 20,
            "radius": 16,
            "bg": "$colors.neutral.50"
          },
          "children": [
            {
              "_node": {
                "type": "text",
                "props": {
                  "text": "Quantum App",
                  "variant": "heading"
                },
                "children": []
              }
            }
          ]
        }
      },
      "define": {
        "type": "template",
        "name": "AppFrame",
        "$define": {
          "AppFrame": {
            "type": "box",
            "props": {
              "direction": "col",
              "gap": 12,
              "padding": 20,
              "radius": 16,
              "bg": "$colors.neutral.50"
            },
            "children": [
              {
                "_node": {
                  "type": "text",
                  "props": {
                    "text": "Quantum App",
                    "variant": "heading"
                  },
                  "children": []
                }
              }
            ]
          }
        }
      }
    }
  },
  "pipelines": {
    "feedPipeline": {
      "name": "feed.main",
      "namespace": "app.feed",
      "id": "feed.main",
      "mode": "collection",
      "executionMode": "auto",
      "pageSize": 20,
      "primaryKey": "id",
      "prefetchConfig": {
        "warmCache": true
      },
      "steps": [
        {
          "type": "prefetch"
        }
      ]
    }
  },
  "extensions": {
    "roots": {
      "payment": [
        "stripe_card",
        "apple_pay",
        "google_pay"
      ],
      "ai": [
        "chat",
        "completion",
        "image_gen"
      ],
      "commerce": [
        "cart",
        "checkout",
        "receipt"
      ]
    },
    "sdui": {},
    "factories": {}
  },
  "app": {
    "name": "Quantum Studio",
    "version": "2.0.0",
    "environment": "production"
  }
}